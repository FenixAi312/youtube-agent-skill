# YouTube Agent Skill configuration
# Copy this file to `.env` and fill in your credentials.

GOOGLE_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_FOLDER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CHANNEL_ID=

# Optional settings
DEFAULT_LANGUAGE=en
DEFAULT_REGION=US
DEFAULT_PUBLISH_TIME=18:00
MAX_COMPETITORS=5
MAX_VIDEOS_PER_ANALYSIS=20
